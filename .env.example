# Application
APP_ENV="development"
LOG_LEVEL="INFO"

# Polling
# Seconds between polls
POLL_INTERVAL=300
# Seconds allowed per phase of an HTTP request
HTTP_TIMEOUT=10
# Max retries for a failed request before waiting for the next poll
MAX_RETRIES=3

# Database
DATABASE_PATH=/data/pogo_pings.db

# Discord
WEBHOOK_URL="<discord_webhook_url>"
